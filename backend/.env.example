# ---------------------------------------------------------------------------
# TikTok Live Monitor — backend environment configuration
# Copy this file to ".env" and adjust the values for your setup.
# ---------------------------------------------------------------------------

# Port the Express + Socket.IO server listens on
PORT=4000

# Origin(s) allowed to connect to the API/WebSocket (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# The TikTok username to watch by default (without the @).
# Leave blank to require the user to enter it from the dashboard instead.
# IMPORTANT: only monitor accounts you own or are authorized to monitor.
DEFAULT_TIKTOK_USERNAME=

# Comma-separated custom keywords to flag in comments (case-insensitive)
DEFAULT_KEYWORDS=giveaway,discount,order,interested,price

# Minimum/maximum digit length considered a valid phone number after
# normalization (helps filter out order numbers, prices, etc.)
PHONE_MIN_DIGITS=8
PHONE_MAX_DIGITS=15

# Reconnect behaviour if the TikTok Live connection drops
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=4000

# How long to wait for the initial connection before giving up and
# reporting an error (instead of hanging on "Connecting..." forever)
CONNECT_TIMEOUT_MS=20000

# Log level: error | warn | info | debug
LOG_LEVEL=info
